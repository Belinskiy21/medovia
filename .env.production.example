POSTGRES_USER=meditrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meditrack_production
POSTGRES_CACHE_DB=meditrack_production_cache
POSTGRES_QUEUE_DB=meditrack_production_queue
POSTGRES_CABLE_DB=meditrack_production_cable

SECRET_KEY_BASE=generate-with-bin-rails-secret
RAILS_MASTER_KEY=optional-if-production-credentials-are-used
RAILS_LOG_LEVEL=info
MEDITRACK_SERVICE_TOKEN=replace-with-long-random-service-token
RUN_SEEDS=1

FRONTEND_ORIGIN=https://meditrack.example.com
BACKEND_PORT=3001
FRONTEND_PORT=8080

BACKEND_IMAGE=ghcr.io/owner/repository/backend:latest
FRONTEND_IMAGE=ghcr.io/owner/repository/frontend:latest
